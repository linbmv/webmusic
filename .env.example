# WebMusic 部署配置模板
#
# 用法：复制本文件为 .env，按需修改后 `docker compose up -d --build`。
# .env 已在 .gitignore 中，本地修改不会被 git 跟踪，因此 `git pull` 不再与
# docker-compose.yml 冲突。所有变量均为可选，未设置时使用下方默认值。

# 宿主机映射端口（容器内固定 8080）
WEBMUSIC_PORT=8080

# 数据持久化目录（用户、同步快照、服务端下载都存这里）
WEBMUSIC_DATA_DIR=./webmusic-data

# 新用户注册开关：true 开启，false 关闭（已注册用户仍可登录）
REGISTRATION_ENABLED=true

# HTTPS 反向代理下的 Cookie Secure 控制：
#   留空  = 按反向代理传入的 X-Forwarded-Proto 自动判定（推荐）
#   true  = 强制带 Secure（确认始终经 HTTPS 访问时使用）
#   false = 强制不带 Secure（仅本机纯 HTTP 调试时使用）
COOKIE_SECURE=

# 可选：仅在使用 Karpov provider 时填写
KARPOV_API_KEY=

# ── 自定义 Docker 网络 ──
# webmusic 运行在独立 bridge 网络上。以下默认值通常可直接用；
# 若与宿主已有 Docker 网络/网段冲突，或需要固定 IP，则在此调整。

# 真实 Docker 网络名
WEBMUSIC_NETWORK=webmusic-net
# 网段（CIDR），避免与现有网络重叠
WEBMUSIC_SUBNET=172.28.0.0/24
# 网关，须在 WEBMUSIC_SUBNET 内
WEBMUSIC_GATEWAY=172.28.0.1
# 容器固定 IP，须在 WEBMUSIC_SUBNET 内
WEBMUSIC_IP=172.28.0.10

